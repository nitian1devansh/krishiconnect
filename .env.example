# ==============================================================================
# KrishiConnect (कृषि कनेक्ट) - Production-Ready Environment Template
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# Commands to initialize:
#   1. cp .env.example .env
#   2. pnpm db:generate   (generates Prisma Client)
#   3. pnpm db:push       (pushes schema to PostgreSQL)
#   4. pnpm db:seed       (seeds Admin, Farmers, Vendors, and Catalog)
#   5. pnpm dev           (runs both frontend and backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Connect to your local PostgreSQL instance or hosted service (Supabase/Neon/AWS RDS)
DB_USER=krishiconnect
DB_PASSWORD=krishiconnect
DB_NAME=krishiconnect
DB_PORT=5432
DATABASE_URL="postgresql://krishiconnect:krishiconnect@localhost:5432/krishiconnect?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# In production, generate strong 32+ character secrets (e.g. `openssl rand -hex 32`)
JWT_SECRET=krishi_connect_super_jwt_secret_dev_32char_minimum
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=krishi_connect_super_refresh_jwt_secret_dev_32char
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=krishi_cookie_session_secret_change_in_prod

# ------------------------------------------------------------------------------
# 4. Email Notification Provider (SMTP / Gmail / SendGrid / AWS SES)
# ------------------------------------------------------------------------------
# When EMAIL_USER and EMAIL_PASSWORD are empty or contain placeholder values,
# KrishiConnect runs in Development Mode and logs verification links & OTPs to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@krishiconnect.in
EMAIL_PASSWORD=placeholder_smtp_app_password
EMAIL_FROM="KrishiConnect <no-reply@krishiconnect.in>"

# ------------------------------------------------------------------------------
# 5. Mobile SMS & OTP Provider (MSG91 / Fast2SMS / Twilio / Mock)
# ------------------------------------------------------------------------------
# Set SMS_PROVIDER to 'mock' for local development (OTPs logged to terminal)
# Or set to 'msg91' / 'fast2sms' and provide auth credentials for live SMS in India
SMS_PROVIDER=mock
MSG91_AUTH_KEY=placeholder_msg91_auth_key
MSG91_TEMPLATE_ID=placeholder_template_id
FAST2SMS_API_KEY=placeholder_fast2sms_api_key

# ------------------------------------------------------------------------------
# 6. Default Super Admin Seed Account
# ------------------------------------------------------------------------------
# Used by `pnpm db:seed` to provision the initial Super Administrator
ADMIN_NAME="Krishi Administrator"
ADMIN_EMAIL=admin@krishiconnect.in
ADMIN_PHONE=9876543210
ADMIN_PASSWORD="AdminKrishi#2026"

# ------------------------------------------------------------------------------
# 7. Payment Gateway (Razorpay India & Marketplace Escrow)
# ------------------------------------------------------------------------------
PAYMENT_SANDBOX_MODE=true
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# ------------------------------------------------------------------------------
# 8. Document & Asset Uploads (S3 / Cloudflare R2 / Local Disk)
# ------------------------------------------------------------------------------
UPLOAD_LOCAL_FALLBACK=true
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET_NAME=krishiconnect-uploads
S3_ACCESS_KEY_ID=placeholder_s3_key
S3_SECRET_ACCESS_KEY=placeholder_s3_secret

# ------------------------------------------------------------------------------
# 9. Voice Telephony Assistant (Twilio / Exotel / Mock)
# ------------------------------------------------------------------------------
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=placeholder_twilio_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_token
TWILIO_CALLER_NUMBER=+9118005550199
